# Build / venv
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# MkDocs build output
site/

# Local source corpus — Agisoft PDFs, forum scraping output, cloned
# repos are not committed (size, redistribution). The corpus's own
# documentation (README.md, VERSIONS.md) IS committed.
corpus/official/*.pdf
corpus/forum/
corpus/scripts/
# Tier 3 experiment outputs — generated by scripts in scripts/.
# Reproducible by running the verify_*.py scripts; large.
corpus/normals_experiment/
corpus/blending_modes_experiment/
corpus/blending_modes_experiment_2_3/
corpus/samples/
.cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets — should never be committed
.env
.env.*
!.env.example
*.key
*.pem

# Node / Mermaid validator dependencies (scripts/verify_mermaid_rendered.js)
node_modules/
package.json
package-lock.json

# Scratch files
*.log
SCRATCH.md
corpus/freshdesk/

# Internal AI-process artifacts — kept only in the local private companion
# repo (../metashape-expert-manual-private), never in the public repo/history.
JOURNAL.md
retrospectives/
waves/
STRATEGY.md
insights/
